# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (Session pooler). Solo para npm run db:push e import de puzzles.
SUPABASE_DB_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tu email: único usuario con acceso a /admin/review (además de profiles.is_admin=true).
ADMIN_EMAIL=

# ── Pipeline de libros ──
ANTHROPIC_API_KEY=
LESSONS_MODEL=claude-opus-5-5

# ── Tests locales de BD (Postgres desechable, NO la de producción) ──
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/swipe_test

# ── Pagos: Whop (Dashboard → Developer) ──
WHOP_API_KEY=
# Secreto del endpoint de webhook tal como lo muestra Whop (empieza por ws_). Endpoint: <sitio>/api/webhooks/whop
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_MONTHLY=
WHOP_PLAN_YEARLY=
# Opcional: id de la cuenta (biz_...) si tu API key la necesita
WHOP_ACCOUNT_ID=

# ── Cron de la garantía (GET /api/cron/guarantee con Authorization: Bearer <CRON_SECRET>) ──
CRON_SECRET=

# ── E2E completo contra un proyecto Supabase de TEST (nunca producción) ──
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
